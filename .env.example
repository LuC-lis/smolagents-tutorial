# 复制这个文件为 .env，然后填入你自己的值。
# .env 不要提交到公开仓库。

# 你的 API Key
SMOL_API_KEY=

# OpenAI 兼容的 base URL（必须能以 {base}/chat/completions 访问）
#   DeepSeek    https://api.deepseek.com/v1
#   OpenAI      https://api.openai.com/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Ollama 本地 http://localhost:11434/v1   （key 随便填个非空字符串）
SMOL_API_BASE=https://api.deepseek.com/v1

# 模型 id
SMOL_MODEL=deepseek-flash

# 可选：GoogleSearchTool 需要（serpapi.com 申请）
# SERPAPI_API_KEY=
